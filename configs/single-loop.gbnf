root ::= tap | done | failed
tap ::= "{" ws "\"action\"" ws ":" ws "\"tap\"" ws "," ws "\"x\"" ws ":" ws integer ws "," ws "\"y\"" ws ":" ws integer ws "," ws "\"memo\"" ws ":" ws string ws "}"
done ::= "{" ws "\"action\"" ws ":" ws "\"done\"" ws "," ws "\"memo\"" ws ":" ws string ws "}"
failed ::= "{" ws "\"action\"" ws ":" ws "\"failed\"" ws "}"
integer ::= "0" | [1-9] [0-9]{0,3}
string ::= "\"" [a-zA-Z0-9 -]{1,40} "\""
ws ::= [ \t\n]{0,4}
