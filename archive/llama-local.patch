 #include "models.h"
 
+// ============================================================================
+// Qwen2.5-VL ViT tail builder (for mid-ViT VisionTrim experiment)
+//
+// Builds a ViT tail that takes compressed embeddings as input.
+// M-RoPE positions and window attention are preserved — the tail is
+// architecturally identical to the original ViT layers, just with
+// fewer tokens and starting from a specific layer.
+// ============================================================================
+struct qwen2vl_tail_builder {
+    const clip_model  & model;
+    const clip_hparams & hparams;
+    projector_type proj_type;
+
+    int n_embd, d_head, n_head, n_layer;
+    int start_layer;
+    int n_tokens;
+    float kq_scale, eps;
+    int n_wa_pattern;
+
+    ggml_context_ptr ctx0_ptr;
+    ggml_context * ctx0;
+    ggml_cgraph * gf;
+
+    // input tensors
+    ggml_tensor * inp_embd;        // [n_embd, n_tokens] compressed embeddings
+    ggml_tensor * positions;       // [n_tokens*4] M-RoPE positions (i32)
+    ggml_tensor * inv_window_idx;  // [n_tokens/4] window reorder indices (i32)
+    ggml_tensor * window_idx;      // [n_tokens/4] forward window indices (i32)
+    ggml_tensor * window_mask;     // [n_tokens, n_tokens] window attn mask (f32)
+
+    qwen2vl_tail_builder(const clip_model & m, const clip_hparams & hp,
+                         projector_type pt, int sl, int nt,
+                         int wa_pattern)
+        : model(m), hparams(hp), proj_type(pt), start_layer(sl), n_tokens(nt),
+          n_wa_pattern(wa_pattern)
+    {
+        n_embd    = hparams.n_embd;
+        d_head    = hparams.n_head > 0 ? n_embd / hparams.n_head : 64;
+        n_head    = hparams.n_head;
+        n_layer   = hparams.n_layer;
+        kq_scale  = 1.0f / sqrtf((float)d_head);
+        eps       = hparams.eps;
+
+        struct ggml_init_params params = {
+            /*.mem_size   =*/ 256 * 1024 * 1024,
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        ctx0_ptr.reset(ggml_init(params));
+        ctx0 = ctx0_ptr.get();
+
+        gf = ggml_new_graph_custom(ctx0, 4096, false);
+
+        // compressed embeddings input [n_embd, n_tokens]
+        GGML_ASSERT(n_tokens % 4 == 0);
+        inp_embd = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_embd, n_tokens);
+        ggml_set_name(inp_embd, "vt_inp_embd");
+        ggml_set_input(inp_embd);
+
+        // M-RoPE positions [n_tokens * 4]
+        positions = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_tokens * 4);
+        ggml_set_name(positions, "vt_positions");
+        ggml_set_input(positions);
+
+        // window attention indices (only used if n_wa_pattern > 0)
+        if (n_wa_pattern > 0) {
+            inv_window_idx = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_tokens / 4);
+            ggml_set_name(inv_window_idx, "vt_inv_window_idx");
+            ggml_set_input(inv_window_idx);
+
+            window_idx = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, n_tokens / 4);
+            ggml_set_name(window_idx, "vt_window_idx");
+            ggml_set_input(window_idx);
+
+            window_mask = ggml_new_tensor_2d(ctx0, GGML_TYPE_F32, n_tokens, n_tokens);
+            ggml_set_name(window_mask, "vt_window_mask");
+            ggml_set_input(window_mask);
+        }
+    }
+
+    ggml_tensor * build_norm(ggml_tensor * cur, ggml_tensor * mw, ggml_tensor * mb,
+                             int norm_t, float norm_eps, int il) {
+        if (norm_t == NORM_TYPE_RMS) {
+            cur = ggml_rms_norm(ctx0, cur, norm_eps);
+            cur = ggml_mul(ctx0, cur, mw);
+            if (mb) cur = ggml_add(ctx0, cur, mb);
+        } else {
+            cur = ggml_norm(ctx0, cur, norm_eps);
+            cur = ggml_add(ctx0, ggml_mul(ctx0, cur, mw), mb);
+        }
+        (void)il;
+        return cur;
+    }
+
+    ggml_tensor * build_ffn(ggml_tensor * cur, ggml_tensor * up, ggml_tensor * up_b,
+                             ggml_tensor * gate, ggml_tensor * gate_b,
+                             ggml_tensor * down, ggml_tensor * down_b,
+                             ffn_op_type type_op, int il) {
+        ggml_tensor * tmp;
+        if (type_op == FFN_GELU) {
+            tmp = ggml_mul_mat(ctx0, up, cur);
+            if (up_b) tmp = ggml_add(ctx0, tmp, up_b);
+            tmp = ggml_gelu(ctx0, tmp);
+            cur = ggml_mul_mat(ctx0, down, tmp);
+            if (down_b) cur = ggml_add(ctx0, cur, down_b);
+        } else {
+            tmp = ggml_mul_mat(ctx0, up, cur);
+            if (up_b) tmp = ggml_add(ctx0, tmp, up_b);
+            if (gate) {
+                ggml_tensor * tmp2 = ggml_mul_mat(ctx0, gate, cur);
+                if (gate_b) tmp2 = ggml_add(ctx0, tmp2, gate_b);
+                tmp = ggml_mul(ctx0, tmp, ggml_silu(ctx0, tmp2));
+            }
+            cur = ggml_mul_mat(ctx0, down, tmp);
+            if (down_b) cur = ggml_add(ctx0, cur, down_b);
+        }
+        (void)il;
+        return cur;
+    }
+
+    ggml_tensor * build_attn(ggml_tensor * wo, ggml_tensor * wo_b,
+                              ggml_tensor * q, ggml_tensor * k, ggml_tensor * v,
+                              ggml_tensor * attn_mask, float kq_scale, int il) {
+        q = ggml_permute(ctx0, q, 0, 2, 1, 3);
+        k = ggml_permute(ctx0, k, 0, 2, 1, 3);
+        v = ggml_permute(ctx0, v, 0, 2, 1, 3);
+
+        ggml_tensor * cur = ggml_flash_attn_ext(ctx0, q, k, v,
+            attn_mask, kq_scale, 0.0f, 0.0f);
+        cur = ggml_reshape_2d(ctx0, cur, d_head * n_head, n_tokens);
+        cur = ggml_mul_mat(ctx0, wo, cur);
+        if (wo_b) cur = ggml_add(ctx0, cur, wo_b);
+        (void)il;
+        return cur;
+    }
+
+    ggml_cgraph * build() {
+        ggml_tensor * inpL = inp_embd;
+        bool use_window_attn = n_wa_pattern > 0;
+        int mrope_sections[4] = {d_head/4, d_head/4, d_head/4, d_head/4};
+
+        // Apply window reorder to input embeddings (same as original ViT)
+        if (use_window_attn) {
+            // Cast mask to F16 for flash attention (same as original)
+            window_mask = ggml_cast(ctx0, window_mask, GGML_TYPE_F16);
+
+            inpL = ggml_reshape_2d(ctx0, inpL, n_embd * 4, n_tokens / 4);
+            inpL = ggml_get_rows(ctx0, inpL, inv_window_idx);
+            inpL = ggml_reshape_3d(ctx0, inpL, n_embd, n_tokens, 1);
+        }
+
+        // layer loop — same as original, just starts from start_layer
+        for (int il = start_layer; il < n_layer; il++) {
+            const auto & layer = model.layers[il];
+            const bool full_attn = use_window_attn ? (il + 1) % n_wa_pattern == 0 : true;
+
+            ggml_tensor * cur = inpL;
+
+            // layernorm1
+            cur = build_norm(cur, layer.ln_1_w, layer.ln_1_b,
+                (proj_type == PROJECTOR_TYPE_QWEN25VL) ? NORM_TYPE_RMS : NORM_TYPE_NORMAL,
+                eps, il);
+
+            // Q/K/V + M-RoPE + window attention
+            {
+                ggml_tensor * Qcur = ggml_add(ctx0, ggml_mul_mat(ctx0, layer.q_w, cur), layer.q_b);
+                ggml_tensor * Kcur = ggml_add(ctx0, ggml_mul_mat(ctx0, layer.k_w, cur), layer.k_b);
+                ggml_tensor * Vcur = ggml_add(ctx0, ggml_mul_mat(ctx0, layer.v_w, cur), layer.v_b);
+
+                Qcur = ggml_reshape_3d(ctx0, Qcur, d_head, n_head, n_tokens);
+                Kcur = ggml_reshape_3d(ctx0, Kcur, d_head, n_head, n_tokens);
+                Vcur = ggml_reshape_3d(ctx0, Vcur, d_head, n_head, n_tokens);
+
+                // M-RoPE — same as original
+                Qcur = ggml_rope_multi(
+                    ctx0, Qcur, positions, nullptr,
+                    d_head/2, mrope_sections, GGML_ROPE_TYPE_VISION, 32768, 10000, 1, 0, 1, 32, 1);
+                Kcur = ggml_rope_multi(
+                    ctx0, Kcur, positions, nullptr,
+                    d_head/2, mrope_sections, GGML_ROPE_TYPE_VISION, 32768, 10000, 1, 0, 1, 32, 1);
+
+                // window attention mask (same as original)
+                ggml_tensor * attn_mask = full_attn ? nullptr : window_mask;
+
+                cur = build_attn(layer.o_w, layer.o_b, Qcur, Kcur, Vcur, attn_mask, kq_scale, il);
+            }
+
+            cur = ggml_add(ctx0, cur, inpL);
+            inpL = cur;
+
+            // layernorm2
+            cur = build_norm(cur, layer.ln_2_w, layer.ln_2_b,
+                (proj_type == PROJECTOR_TYPE_QWEN25VL) ? NORM_TYPE_RMS : NORM_TYPE_NORMAL,
+                eps, il);
+
+            // FFN
+            cur = build_ffn(cur, layer.ff_up_w, layer.ff_up_b,
+                layer.ff_gate_w, layer.ff_gate_b,
+                layer.ff_down_w, layer.ff_down_b,
+                hparams.ffn_op, il);
+
+            cur = ggml_add(ctx0, inpL, cur);
+            inpL = cur;
+        }
+
+        // post-layernorm
+        if (model.post_ln_w) {
+            inpL = build_norm(inpL, model.post_ln_w, model.post_ln_b,
+                (proj_type == PROJECTOR_TYPE_QWEN25VL) ? NORM_TYPE_RMS : NORM_TYPE_NORMAL,
+                eps, n_layer);
+        }
+
+        // projector: 4-way merge + MLP GELU + window reverse
+        ggml_tensor * embeddings = inpL;
+        embeddings = ggml_reshape_3d(ctx0, embeddings, n_embd * 4, n_tokens / 4, 1);
+        embeddings = build_ffn(embeddings,
+            model.mm_0_w, model.mm_0_b,
+            nullptr, nullptr,
+            model.mm_1_w, model.mm_1_b,
+            FFN_GELU, -1);
+
+        // window reverse (same as original)
+        if (use_window_attn) {
+            int proj_dim = hparams.projection_dim;
+            embeddings = ggml_reshape_2d(ctx0, embeddings, proj_dim, n_tokens / 4);
+            embeddings = ggml_get_rows(ctx0, embeddings, window_idx);
+            embeddings = ggml_reshape_3d(ctx0, embeddings, proj_dim, n_tokens / 4, 1);
+        }
+
+        ggml_build_forward_expand(gf, embeddings);
+        return gf;
+    }
+};
