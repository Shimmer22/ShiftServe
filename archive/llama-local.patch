+    // Pre-collect text token IDs for VisionTrim TGVC guidance
+    std::vector<llama_token> all_text_tokens;
+    if (use_visiontrim) {
+        for (size_t i = 0; i < n_chunks; i++) {
+            auto chunk = mtmd_input_chunks_get(chunks, i);
+            if (mtmd_input_chunk_get_type(chunk) == MTMD_INPUT_CHUNK_TYPE_TEXT) {
+                size_t n_tokens;
+                const auto tokens = mtmd_input_chunk_get_tokens_text(chunk, &n_tokens);
+                all_text_tokens.insert(all_text_tokens.end(), tokens, tokens + n_tokens);
+            }
+        }
+    }
+
+    // Get text token embeddings for TGVC guidance
+    const llama_model * model = llama_get_model(lctx);
+    int n_embd_inp = llama_model_n_embd_inp(model);
+    std::vector<float> text_embd;
+    double vt_text_embd_ms = 0.0;
+    if (use_visiontrim && !all_text_tokens.empty()) {
+        int64_t t_embd_us = ggml_time_us();
+        text_embd.resize(all_text_tokens.size() * n_embd_inp);
+        int ret = llama_model_get_token_embeddings(
+            model, all_text_tokens.data(), (int32_t)all_text_tokens.size(), text_embd.data());
+        vt_text_embd_ms = (ggml_time_us() - t_embd_us) / 1000.0;
+        if (ret != 0) {
+            LOG_WRN("[VisionTrim] failed to get token embeddings, TGVC will use fallback\n");
+            text_embd.clear();
+        } else {
+            LOG_INF("[VisionTrim] collected %zu text token embeddings for TGVC guidance (%.1f ms)\n",
+                    all_text_tokens.size(), vt_text_embd_ms);
+        }
+    }
+
     for (size_t i = 0; i < n_chunks; i++) {
         bool chunk_logits_last = (i == n_chunks - 1) && logits_last;
         auto chunk = mtmd_input_chunks_get(chunks, i);
+        auto chunk_type = mtmd_input_chunk_get_type(chunk);
+
+        // Mid-ViT also needs the VisionTrim decode path (for correct token count)
+        bool is_midvit = (getenv("MTMD_VISIONTRIM_VIT_LAYER") != nullptr);
+
+        if (chunk_type != MTMD_INPUT_CHUNK_TYPE_IMAGE || (!use_visiontrim && !is_midvit)) {
+            // Normal path: use existing single-chunk eval
