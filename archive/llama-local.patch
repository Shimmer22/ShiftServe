+    // Check if VisionTrim is enabled
+    const char * vt_env = getenv("MTMD_VISIONTRIM");
+    bool use_visiontrim = (vt_env && strcmp(vt_env, "1") == 0);
+    float retain_ratio  = 1.0f;  // default: identity (no post-ViT compression)
+    float dvts_ratio    = 1.0f;
