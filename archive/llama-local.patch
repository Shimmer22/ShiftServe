+            LOG_INF("[VisionTrim] identity passthrough: %d tokens (ratio=1.0 dvts=1.0)\n", n_img_tokens);
+        } else {
+            int64_t t_vt_us = ggml_time_us();
+            compressed_embd.resize(n_img_tokens * n_embd_inp);
+            n_compressed = visiontrim_compress(
+                embd, n_img_tokens,
+                text_embd.empty() ? nullptr : text_embd.data(),
+                text_embd.empty() ? 0 : (int32_t)(text_embd.size() / n_embd_inp),
+                n_embd_inp,
+                retain_ratio, dvts_ratio, tgvc_iter,
+                compressed_embd.data(), n_img_tokens, nullptr);
+            vt_compress_ms = (ggml_time_us() - t_vt_us) / 1000.0;
+
+            if (n_compressed <= 0) {
+                LOG_ERR("visiontrim_compress failed\n");
+                return -1;
+            }
+            decode_embd_ptr = compressed_embd.data();
+            owns_compressed = true;
+
+            LOG_INF("[VisionTrim] compressed %d→%d tokens (%.1f%% reduction) in %.1f ms\n",
+                    n_img_tokens, n_compressed, 100.0f * (1.0f - (float)n_compressed / n_img_tokens),
+                    vt_compress_ms);
+
+            LOG_INF("=== VisionTrim Timing ===\n");
+            LOG_INF("  Text Emb Lookup:    %8.1f ms\n", vt_text_embd_ms);
+            LOG_INF("  DVTS + TGVC:        %8.1f ms\n", vt_compress_ms);
+            LOG_INF("  Total VisionTrim:   %8.1f ms\n", vt_text_embd_ms + vt_compress_ms);
+        }
+
+        // Decode compressed image embeddings with correct M-RoPE 2D positions
+        bool use_mrope = mtmd_decode_use_mrope(ctx);
+        int n_pos_per_embd = use_mrope ? 4 : 1;
+
+        const auto image_tokens = mtmd_input_chunk_get_tokens_image(chunk);
+        decode_embd_batch batch_embd(decode_embd_ptr, n_compressed, n_pos_per_embd, n_embd_inp);
+
+        if (use_mrope && image_tokens) {
+            // Get original 2D positions
+            const auto n_orig = (int32_t)mtmd_image_tokens_get_n_tokens(image_tokens);
+            std::vector<mtmd_decoder_pos> orig_pos(n_orig);
+            mtmd_helper_image_get_decoder_pos(image_tokens, n_past, orig_pos.data());
+
+            if (n_compressed == n_orig) {
+                // No compression: use original 2D positions directly
+                batch_embd.set_position_mrope_2d(orig_pos, seq_id);
+            } else {
+                // Compressed: assign sequential positions
+                std::vector<mtmd_decoder_pos> comp_pos(n_compressed);
+                for (int32_t i = 0; i < n_compressed; i++) {
+                    comp_pos[i].t = n_past;
+                    comp_pos[i].x = (uint32_t)i;
+                    comp_pos[i].y = 0;
+                    comp_pos[i].z = 0;
+                }
+                batch_embd.set_position_mrope_2d(comp_pos, seq_id);
+            }
+        } else if (use_mrope) {
+            batch_embd.set_position_mrope_1d(n_past, seq_id);
+        } else {
+            batch_embd.set_position_normal(n_past, seq_id);
+        }
+
+        const bool use_non_causal = mtmd_decode_use_non_causal(ctx, chunk);
+        if (use_non_causal) llama_set_causal_attn(lctx, false);
+
+        int32_t i_batch = 0;
+        int32_t n_img_batches = (n_compressed + n_batch - 1) / n_batch;
+        while (i_batch < n_img_batches) {
+            int pos_offset = i_batch * n_batch;
+            int n_tokens_batch = std::min(n_batch, n_compressed - pos_offset);
+            llama_batch batch_embd_view = batch_embd.get_view(pos_offset, n_tokens_batch);
+
+            int32_t dec_ret = llama_decode(lctx, batch_embd_view);
+            if (dec_ret != 0) {
+                LOG_ERR("failed to decode image (visiontrim)\n");
+                if (use_non_causal) llama_set_causal_attn(lctx, true);
+                return dec_ret;
+            }
+            i_batch++;
+        }
+
+        if (use_non_causal) llama_set_causal_attn(lctx, true);
+
+        // For M-RoPE, n_past advances by max(t,h,w), not by n_tokens
+        // This must match mtmd_helper_decode_image_chunk's behavior
+        if (use_mrope) {
+            n_past += mtmd_input_chunk_get_n_pos(chunk);
+        } else {
+            n_past += n_compressed;
         }
         *new_n_past = n_past;
     }
