--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -18,6 +18,7 @@
 
 #include "ggml.h"
 #include "ggml-cpp.h"
+#include "ggml-backend.h"
 
 #include <algorithm>
 #include <cassert>
@@ -2134,6 +2135,41 @@ int32_t llama_model_n_embd_out(const llama_model * model) {
     return model->hparams.n_embd_out();
 }
 
+int32_t llama_model_get_token_embeddings(
+        const struct llama_model * model,
+        const llama_token * tokens,
+        int32_t n_tokens,
+        float * output) {
+    if (!model->tok_embd) {
+        return -1;
+    }
+
+    const int n_vocab = llama_vocab_n_tokens(&model->vocab);
+    const int n_embd  = model->hparams.n_embd_inp();
+    const float type_sizef = (float)ggml_type_sizef(model->tok_embd->type);
+    const int   stride_tensor = (int)(n_vocab * type_sizef);
+
+    for (int32_t i = 0; i < n_tokens; i++) {
+        int token_id = tokens[i];
+        if (token_id < 0 || token_id >= n_vocab) {
+            // invalid token, zero the embedding
+            memset(output + i * n_embd, 0, n_embd * sizeof(float));
+            continue;
+        }
+        size_t offset = (size_t)(token_id * type_sizef);
+        ggml_backend_tensor_get_2d(
+            model->tok_embd,
+            output + i * n_embd,
+            offset,
+            (size_t)type_sizef,
+            n_embd,
+            stride_tensor,
+            sizeof(float));
+    }
+
+    return 0;
+}
+
 int32_t llama_model_n_layer(const llama_model * model) {
     return model->hparams.n_layer;
 }
