+namespace {
+struct a2o_graph_profile {
+    int64_t build_us = 0, dispatch_us = 0, sync_us = 0;
+    int64_t builds = 0, graphs = 0, callback_graphs = 0;
+};
+thread_local a2o_graph_profile * a2o_active_graph_profile = nullptr;
+thread_local a2o_graph_profile a2o_graph_profile_storage;
+
+struct a2o_graph_timer {
+    int64_t * target;
+    int64_t start;
+    explicit a2o_graph_timer(int64_t * target) : target(target), start(target ? ggml_time_us() : 0) {}
+    ~a2o_graph_timer() { if (target) *target += ggml_time_us() - start; }
+};
+}
+
+extern "C" LLAMA_API void llama_a2o_graph_profile_begin() {
+    a2o_graph_profile_storage = {};
+    a2o_active_graph_profile = &a2o_graph_profile_storage;
+}
+
+extern "C" LLAMA_API void llama_a2o_graph_profile_end(int64_t * out) {
+    const auto & p = a2o_graph_profile_storage;
+    out[0] = p.build_us; out[1] = p.dispatch_us; out[2] = p.sync_us;
+    out[3] = p.builds; out[4] = p.graphs; out[5] = p.callback_graphs;
+    a2o_active_graph_profile = nullptr;
+}
+
+void llama_context::a2o_set_eval_callback(ggml_backend_sched_eval_callback callback, void * user_data) {
+    cparams.cb_eval = callback;
+    cparams.cb_eval_user_data = user_data;
+    if (sched) {
+        ggml_backend_sched_set_eval_callback(sched.get(), callback, user_data);
+    }
+}
+
+extern "C" LLAMA_API void llama_a2o_set_eval_callback(llama_context * ctx,
+        ggml_backend_sched_eval_callback callback, void * user_data) {
+    ctx->a2o_set_eval_callback(callback, user_data);
+}
