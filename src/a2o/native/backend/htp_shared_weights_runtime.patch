+llama_context * llama_a2o_init_shared_cpu(llama_model *model, llama_context_params params) {
+    using namespace a2o::shared_weights;
+    if (!enabled() || !model || model->arch != LLM_ARCH_QWEN3 || model->devices.size() != 1 ||
+        std::strcmp(ggml_backend_dev_name(model->devices[0].dev), "HTP0") != 0) {
+        LLAMA_LOG_ERROR("%s: requires opt-in dense Qwen3 with exactly one HTP0 model device\n", __func__);
+        return nullptr;
+    }
+    size_t packed_bytes = 0;
+    for (const auto &entry : model->tensors_by_name) {
+        const auto *t = entry.second;
+        auto buft = ggml_backend_buffer_get_type(t->buffer);
+        if (packed_type(buft)) {
+            if ((t->type != GGML_TYPE_Q4_0 && t->type != GGML_TYPE_Q8_0) ||
+                !ggml_is_matrix(t) || !ggml_is_contiguous(t) || t->ne[0] % 32 != 0) {
+                LLAMA_LOG_ERROR("%s: unsupported packed weight %s\n", __func__, t->name);
+                return nullptr;
+            }
+            packed_bytes += ggml_nbytes(t);
+        } else if (hexagon_buffer(buft, "HTP0") &&
+                   (!ggml_backend_buft_is_host(buft) || ggml_is_quantized(t->type))) {
+            LLAMA_LOG_ERROR("%s: incompatible HTP0 tensor %s\n", __func__, t->name);
+            return nullptr;
+        }
+    }
+    if (!packed_bytes || params.n_samplers) {
+        LLAMA_LOG_ERROR("%s: no shared weights or unsupported backend sampler\n", __func__);
+        return nullptr;
+    }
+    LLAMA_LOG_INFO("%s: CPU-only scheduler, shared packed weights %zu bytes\n", __func__, packed_bytes);
+    params.offload_kqv = false;
+    params.op_offload = false;
+    return init_context(model, params, true);
 }
 
