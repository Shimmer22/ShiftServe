+// Private A2O telemetry transported through existing profile PMU slots.
+// These slots are route metadata in this build, NOT hardware PMU counters.
+static void a2o_record_route(struct htp_ops_context * octx, uint32_t path, uint32_t reason, int ret) {
+    octx->a2o_route_tag = 0xA2100000u | (reason << 8) | path;
+    octx->a2o_route_data[0] = (uint32_t)octx->src[1]->ne[1]; // actual M
+    octx->a2o_route_data[1] = (uint32_t)octx->src[0]->ne[1]; // actual N
+    octx->a2o_route_data[2] = (uint32_t)octx->src[0]->ne[0]; // actual K
+    octx->a2o_route_data[3] = (uint32_t)octx->src[0]->type;
+    octx->a2o_route_data[4] = octx->ctx->a2o_mc; (void)ret;
+    octx->a2o_route_data[5] = octx->ctx->a2o_nc;
+    octx->a2o_route_data[6] = octx->ctx->a2o_layout;
+}
