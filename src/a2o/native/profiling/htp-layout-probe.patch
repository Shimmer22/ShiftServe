+        a2o_record_route(octx, 1, 1, 0);
         return op_matmul_hvx(octx);
     }
 
     // HMX weight tile requires N to be 32-aligned.
     if (src0->ne[1] % 32 != 0) {
+        a2o_record_route(octx, 1, 2, 0);
         return op_matmul_hvx(octx);
     }
 
